<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.quizbattle.client.ui.components.TrophyMark?>
<ScrollPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.quizbattle.client.ui.controller.FinalResultsController" fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
<content><StackPane alignment="TOP_CENTER" styleClass="game-page"><VBox spacing="24" maxWidth="1000" minWidth="0" alignment="TOP_CENTER">
    <TrophyMark/><Label text="BATTLE COMPLETE" styleClass="eyebrow"/>
    <Label fx:id="winnerName" styleClass="page-title" wrapText="true"/><Label fx:id="personalResult" styleClass="body-secondary" wrapText="true"/>
    <StackPane fx:id="podiumHost" maxWidth="800"/>
    <VBox fx:id="standingsHost" maxWidth="850" minWidth="0"/>
    <HBox alignment="CENTER" spacing="16"><Button fx:id="returnToLobby" text="Return to Lobby →" onAction="#lobby" styleClass="primary-button,hero-button"/><Button text="Disconnect" onAction="#logout" styleClass="outline-button"/></HBox>
</VBox></StackPane></content></ScrollPane>
